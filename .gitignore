# Real-world dataset content (downloaded raw sources, generated testcases,
# logs). Scripts and docs stay tracked; only .gitkeep files are kept.
tests/testcases/datasets/raw/*
!tests/testcases/datasets/raw/.gitkeep
tests/testcases/datasets/derived/*
!tests/testcases/datasets/derived/.gitkeep
tests/testcases/datasets/logs/*
!tests/testcases/datasets/logs/.gitkeep

# Vendored dependencies (local clones)
third_party/*
